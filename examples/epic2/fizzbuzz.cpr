fn I32 main() {
    I32 number, div3, div5;

    while (read(&number)) {
        div3 = number % 3;    
        div5 = number % 5;

        if (div3 == 0) {
            if(div 5 == 0) {
                println("FizzBuzz");
            }
        } else if (div3 == 0) {
            println("Fizz");
        } else if (div5 == 0) {
            println("Buzz");
        } else {
            println(number);
        }
    }

    return 0;
}
