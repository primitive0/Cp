fn I32 main() {
    I32 variable = 4;

    /* &x is an address-of operator.
       For values &x returns read-write pointer.
    */
    println(&variable); /* Address of variable */

    /* &(23) <-- Cannot take address of rvalue! */


    /* T const* is a read-only pointer */
    I32 const* ro_ptr = &variable;
    println(*ro_ptr); /* 4 */

    /* Cannot change underlying value of read-only pointer */
    /* *ro_ptr = 43; */

    ++variable;
    println(*ro_ptr); /* 5 */


    /* T* is a read-write pointer */
    I32* ptr = &variable;

    *ptr += 3;

    println(variable); /* 8 */


    return 0;
}
