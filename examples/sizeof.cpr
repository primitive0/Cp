fn I32 main() {
    println(sizeof Bool)    /* 1 */
    println(sizeof I32)     /* 4 */
    println(sizeof U8)      /* 1 */
    println(sizeof Unit)    /* 0 */
    println(sizeof Unit[5]) /* 0 */
    println(sizeof Unit[])  /* 2 * sizeof Usz */
    println(sizeof Unit*)   /* sizeof Usz */

    return 0;
}
