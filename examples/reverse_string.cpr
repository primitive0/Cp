fn I32 main() {
    /* readln() will automatically allocate memory for string */
    U8[] string;
    if (!readln(&string)) {
        return 1;
    }

    I32 n = len(string);
    for (I32 i = 0; i < n / 2; ++i) {
        U8 tmp = string[i];
        string[i] = string[n-1-i];
        string[n-1-i] = tmp;
    }

    println(string);

    /* Free string to avoid memory leaks */
    free((U8*) string);

    return 0;
}
