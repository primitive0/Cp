fn I32 main() {
    const I32 kSpecialNumber = 42;

    println(kSpecialNumber);  /* 42 */
    println(&kSpecialNumber); /* address of kSpecialNumber */

    /* kSpecialNumber = 43; <-- Compile-time error! */


    /* Constant arrays are supported */
    const I32[5] kSpecialArray = [ 0, 1, 0, 1, 0 ];


    /* Constants are values that are computed during compilation */
    /* const I32 foo = get_foo(); <-- Compile-time error! */

    /* Constant expressions are not supported */
    /* const I32 bar = kSpecialNumber; <-- Compile-time error! */


    return 0;
}
