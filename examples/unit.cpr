fn I32 main() {
    /* Unit is a zero-sized type in C' */
    /* This variable definition is no-op */
    Unit unit = {};

    /* This also takes no memory */
    Unit[5] array_of_units = [ {}, {}, {}, {}, {} ];

    /* Unit* takes memory and is non-null */
    Unit* unit_ptr = &unit;
    println(unit_ptr); /* some dangling address, implementation-defined */

    /* Unit* is used as universal pointer (like void* in C) */

    return 0;
}
