fn I32 main() {
    /* alloc() returns U8* */
    U8* data = alloc(sizeof I32 * 3);

    /* Create slice using subscript operator */
    I32[] ints = ((I32*) data)[0:3];

    ints[0] = 11;
    ints[1] = 12;
    ints[2] = 13;
    /* ints[3] = 14; <-- UB! */

    println(ints[1], " ", ints[2], " ", ints[3]);

    /* Free memory to avoid leaks */
    free(data);

    return 0;
}
