fn I32 main() {
    /* alloc() returns Unit* */
    Unit* ptr = alloc(sizeof I32 * 3);

    /* @ is a slice creation operator */
    I32[] array = ((I32*) ptr) @ 3;

    array[0] = 11;
    array[1] = 12;
    array[2] = 13;
    /* array[3] = 14; <-- UB! */

    println(array[1], " ", array[2], " ", array[3]);

    /* Free memory to avoid leaks */
    free(ptr);

    return 0;
}
