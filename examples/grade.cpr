fn I32 main() {
    I32 grade;
    if (!read(&grade)) {
        return 1;
    }

    if (grade == 1) {
        println("Плохо");
    } else if (grade == 2) {
        println("Неудовлетворительно");
    } else if (grade == 3) {
        println("Удовлетворительно");
    } else if (grade == 4) {
        println("Хорошо");
    } else if (grade == 5) {
        println("Отлично");
    } else {
        println("Некорректная оценка");
    }

    return 0;
}
